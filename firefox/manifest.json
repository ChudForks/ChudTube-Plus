{
  "manifest_version": 3,
  "name": "ChudTube+ for Firefox",
  "short_name": "ChudTube+",
  "version": "0.5.0",
  "description": "Customize YouTube and YouTube Music with custom themes, OLED presets, content filters, lyrics, and optional SponsorBlock auto-skip.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chudtube-plus-firefox@chudforks.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChudTube+",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*",
    "*://music.youtube.com/*",
    "*://lrclib.net/*",
    "https://sponsor.ajay.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "exclude_matches": [
        "*://music.youtube.com/*",
        "*://*.music.youtube.com/*"
      ],
      "js": ["src/content/yt-boot.js"],
      "css": ["src/content/yt.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.youtube.com/*", "*://*.music.youtube.com/*"],
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["src/inject/ytm-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://music.youtube.com/*", "*://*.music.youtube.com/*"],
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["src/content/boot.js"],
      "css": ["src/content/ytm.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "resources": [
        "src/content/yt.js",
        "src/content/yt.css",
        "src/content/sponsorblock.js",
        "src/lib/settings.js",
        "src/lib/theme.js"
      ]
    },
    {
      "matches": ["*://music.youtube.com/*", "*://*.music.youtube.com/*"],
      "resources": [
        "src/content/ytm.js",
        "src/content/ytm-theme.js",
        "src/content/sponsorblock.js",
        "src/lib/*.js",
        "src/inject/ytm-main.js"
      ]
    }
  ]
}
